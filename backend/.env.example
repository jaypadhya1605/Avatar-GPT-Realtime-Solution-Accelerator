APP_ENV=local
APP_MODE=mock
BUILD_LABEL=local
ALLOWED_ORIGINS=http://localhost:8000
FRONTEND_DIST_PATH=../frontend/dist
SESSION_MAX_MINUTES=15
PERSIST_RESULTS=false

# Required only for a local Azure Voice Live session.
AZURE_VOICELIVE_ENDPOINT=https://YOUR-ACCOUNT.services.ai.azure.com/
AZURE_VOICELIVE_MODEL=gpt-realtime-1.5
AZURE_VOICELIVE_TRANSCRIPTION_MODEL=azure-speech

# Limited Access Preview. Leave disabled for the GA local-portrait experience.
AZURE_CUSTOM_PHOTO_AVATAR_ENABLED=false
AZURE_CUSTOM_PHOTO_AVATAR_MODEL=vasa-1
AZURE_CUSTOM_PHOTO_AVATAR_OUTPUT_PROTOCOL=webrtc
AZURE_CUSTOM_PHOTO_AVATAR_CHARACTER_SCN_001=
AZURE_CUSTOM_PHOTO_AVATAR_CHARACTER_SCN_002=
AZURE_CUSTOM_PHOTO_AVATAR_CHARACTER_SCN_003=